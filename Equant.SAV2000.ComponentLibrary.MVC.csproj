<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Equant.SAV2000.ComponentLibrary.MVC</RootNamespace>
    <AssemblyName>Equant.SAV2000.ComponentLibrary.MVC</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>ORANGE</Company>
    <Product>Equant.SAV2000.ComponentLibrary.MVC</Product>
    <Copyright>Copyright © ORANGE 2014</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core MVC 8 -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.ViewFeatures" Version="2.2.0" />
    
    <!-- Entity Framework Core 8 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    
    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    
    <!-- System.ComponentModel.Annotations for validation attributes -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded JavaScript resources -->
    <EmbeddedResource Include="Resources\Javascripts\*.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Common library - will need to be updated or removed -->
    <!-- <ProjectReference Include="..\Equant.SAV2000.ComponentLibrary.Common\Equant.SAV2000.ComponentLibrary.Common.csproj" /> -->
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude unmigrated validators, models, and some infrastructure from build -->
    <Compile Remove="Infrastructure\PageProvider.cs" />
    <Compile Remove="Infrastructure\ConditionalAttributes.cs" />
    <Compile Remove="Models\**" />
    <Compile Remove="Validators\**" />
    
    <!-- Exclude test projects from main library build -->
    <Compile Remove="Equant.SAV2000.ComponentLibrary.MVC.UnitTests\**" />
    <Compile Remove="Equant.SAV2000.ComponentLibrary.MVC.IntegrationTests\**" />
    <Compile Remove="Equant.SAV2000.ComponentLibrary.MVC.E2ETests\**" />
  </ItemGroup>

</Project>
