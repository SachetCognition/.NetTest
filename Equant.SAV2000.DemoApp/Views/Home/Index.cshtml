@using Equant.SAV2000.ComponentLibrary.MVC.Extensions
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Equant.SAV2000 Component Library Demo</title>
    <script src="https://code.jquery.com/jquery-1.11.3.min.js"></script>
    <script src="@Url.Action("EmbeddedScript", "Home", new { name = "Common.js" })"></script>
    <script src="@Url.Action("EmbeddedScript", "Home", new { name = "Button.js" })"></script>
    <script src="@Url.Action("EmbeddedScript", "Home", new { name = "CheckBox.js" })"></script>
</head>
<body>
    <h1>Equant.SAV2000.ComponentLibrary.MVC demo</h1>

    <h2>ButtonComponent</h2>
    @(Html.Sav2000().Button()
        .Id("demoButton")
        .Name("demoButton")
        .Value("demoButton")
        .Title("Demo button")
        .CssClass("demo-button")
        .OnClick("function () { $('#clickResult').text('Button clicked at ' + new Date().toLocaleTimeString()); }"))

    <p id="clickResult"></p>

    <h2>CheckBoxComponent</h2>
    @(Html.Sav2000().CheckBox()
        .Id("demoCheckBox")
        .Name("demoCheckBox")
        .IsChecked(true)
        .Title("Demo checkbox")
        .OnChange("function () { $('#checkResult').text('Checkbox changed: ' + $('#demoCheckBox').prop('checked')); }"))

    <p id="checkResult"></p>
</body>
</html>
